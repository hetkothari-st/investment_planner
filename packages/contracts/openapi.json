 "components": {
  "schemas": {
   "AuthStatus": {
    "properties": {
     "authenticated": {
      "type": "boolean",
      "title": "Authenticated"
     },
     "degraded_reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Degraded Reason"
     }
    },
    "type": "object",
    "required": [
     "authenticated",
     "degraded_reason"
    ],
    "title": "AuthStatus"
   },
   "BlockOut": {
    "properties": {
     "provenance": {
      "type": "string",
      "title": "Provenance"
     },
     "kind": {
      "type": "string",
      "title": "Kind"
     },
     "content": {
      "type": "string",
      "title": "Content"
     }
    },
    "type": "object",
    "required": [
     "provenance",
     "kind",
     "content"
    ],
    "title": "BlockOut"
   },
   "CandidateOut": {
    "properties": {
     "isin": {
      "type": "string",
      "title": "Isin"
     },
     "tradingsymbol": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Tradingsymbol"
     },
     "composite_pctl": {
      "type": "number",
      "title": "Composite Pctl"
     },
     "coverage": {
      "type": "number",
      "title": "Coverage"
     },
     "conviction": {
      "type": "string",
      "title": "Conviction"
     }
    },
    "type": "object",
    "required": [
     "isin",
     "tradingsymbol",
     "composite_pctl",
     "coverage",
     "conviction"
    ],
    "title": "CandidateOut"
   },
   "CandidatesOut": {
    "properties": {
     "horizon": {
      "type": "string",
      "title": "Horizon"
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     },
     "candidates": {
      "items": {
       "$ref": "#/components/schemas/CandidateOut"
      },
      "type": "array",
      "title": "Candidates"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "horizon",
     "as_of",
     "candidates",
     "message"
    ],
    "title": "CandidatesOut"
   },
   "ClosePositionIn": {
    "properties": {
     "reason": {
      "type": "string",
      "title": "Reason"
     },
     "journal_note": {
      "type": "string",
      "title": "Journal Note"
     },
     "price": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Price"
     }
    },
    "type": "object",
    "required": [
     "reason",
     "journal_note"
    ],
    "title": "ClosePositionIn"
   },
   "DebtIn-Input": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "principal_outstanding": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       }
      ],
      "title": "Principal Outstanding"
     },
     "annual_rate_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       }
      ],
      "title": "Annual Rate Pct"
     },
     "min_emi": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       }
      ],
      "title": "Min Emi",
      "default": "0"
     },
     "tax_deductible": {
      "type": "boolean",
      "title": "Tax Deductible",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "label",
     "principal_outstanding",
     "annual_rate_pct"
    ],
    "title": "DebtIn"
   },
   "DebtIn-Output": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "principal_outstanding": {
      "type": "integer",
      "title": "Principal Outstanding"
     },
     "annual_rate_pct": {
      "type": "string",
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Annual Rate Pct"
     },
     "min_emi": {
      "type": "integer",
      "title": "Min Emi",
      "default": 0
     },
     "tax_deductible": {
      "type": "boolean",
      "title": "Tax Deductible",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "label",
     "principal_outstanding",
     "annual_rate_pct"
    ],
    "title": "DebtIn"
   },
   "FalsifierIn": {
    "properties": {
     "field_id": {
      "type": "string",
      "title": "Field Id"
     },
     "operator": {
      "type": "string",
      "title": "Operator"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       }
      ],
      "title": "Threshold"
     },
     "human_text": {
      "type": "string",
      "title": "Human Text"
     }
    },
    "type": "object",
    "required": [
     "field_id",
     "operator",
     "threshold",
     "human_text"
    ],
    "title": "FalsifierIn"
   },
   "GateResult": {
    "properties": {
     "gate": {
      "type": "string",
      "title": "Gate"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "status": {
      "$ref": "#/components/schemas/GateStatus"
     },
     "amount": {
      "type": "integer",
      "title": "Amount"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     }
    },
    "type": "object",
    "required": [
     "gate",
     "label",
     "status",
     "amount",
     "reason"
    ],
    "title": "GateResult"
   },
   "GateStatus": {
    "type": "string",
    "enum": [
     "PASSED",
     "BLOCKED",
     "INFO"
    ],
    "title": "GateStatus"
   },
   "GoalIn-Input": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "target_amount": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       }
      ],
      "title": "Target Amount"
     },
     "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
     },
     "priority": {
      "$ref": "#/components/schemas/GoalPriority",
      "default": "SHOULD"
     }
    },
    "type": "object",
    "required": [
     "label",
     "target_amount",
     "target_date"
    ],
    "title": "GoalIn"
   },
   "GoalIn-Output": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "target_amount": {
      "type": "integer",
      "title": "Target Amount"
     },
     "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
     },
     "priority": {
      "$ref": "#/components/schemas/GoalPriority",
      "default": "SHOULD"
     }
    },
    "type": "object",
    "required": [
     "label",
     "target_amount",
     "target_date"
    ],
    "title": "GoalIn"
   },
   "GoalPriority": {
    "type": "string",
    "enum": [
     "MUST",
     "SHOULD",
     "WANT"
    ],
    "title": "GoalPriority"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
