    "required": [
     "gates",
     "investable_monthly",
     "investable_lumpsum",
     "buffer_target",
     "buffer_current",
     "buffer_eta_months",
     "blocking_reasons",
     "spending_recommendations",
     "max_equity_fraction",
     "horizon_buckets",
     "assumptions_version",
     "sensitivity"
