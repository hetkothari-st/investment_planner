# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://corpus:corpus@localhost:5432/corpus
REDIS_URL=redis://localhost:6379/0

# Kite Connect (docs/02-DATA-LAYER.md) — needed from M1
KITE_API_KEY=
KITE_API_SECRET=

# Anthropic (docs/07-REPORT-CONTRACT.md) — needed from M6
ANTHROPIC_API_KEY=

# Live layer (docs/02, M9). CORPUS_FEED = off | replay | hub | kite
#   replay: deterministic demo data, no network
#   hub:    JSON websocket relay (e.g. a Railway hub holding the Kite session)
#   kite:   KiteTicker directly, token from the daily /auth/kite/login
CORPUS_FEED=off
WS_HUB_URL=
# Optional JSON sent once on hub connect, e.g. {"action":"subscribe","tokens":[256265]}
WS_HUB_SUBSCRIBE=

# Nightly pipeline scheduler (docs/01, 16:15 IST). 1 to enable.
CORPUS_SCHEDULER=0
